{
  "name": "minicode",
  "description": "A terse terminal coding agent powered by Google Gemini models",
  "version": "1.0.0",
  "author": "Your Name",
  "entrypoint": "minicode_agent:MinicodeAgent",
  "capabilities": {
    "supports_atif": false,
    "supports_windows": false,
    "supports_gui": false
